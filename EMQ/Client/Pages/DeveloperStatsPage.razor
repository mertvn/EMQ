@page "/DeveloperStats"
@using EMQ.Client.Components
@using EMQ.Shared.Library.Entities.Concrete.Dto
@using EMQ.Shared.Library.Entities.Concrete.Dto.Request
@using EMQ.Shared.Quiz.Entities.Concrete
@using Microsoft.AspNetCore.Components.QuickGrid
@inject HttpClient _client
@inject ClientUtils _clientUtils

<a class="link link-primary" href="/eu/all">Browse users</a>
<br/>

<h3>Developer stats</h3>
<p>Search for player totals across a developer's songs.</p>

<form class="developer-search" @onsubmit="Search" @onsubmit:preventDefault>
    <div class="search-field">
        <label for="developer-id">VNDB ID</label>
        <input id="developer-id" type="search" class="form-control" placeholder="e.g. p123"
               @bind="_search.DeveloperId" @bind:event="oninput" aria-describedby="developer-search-help"/>
    </div>
    <div class="search-field">
        <label>Name</label>
        <AutocompleteDeveloperComponent @ref="_developerAutocomplete"
                                        Placeholder="Developer name"
                                        IsQuizPage="false"
                                        @bind-Guess="_search.Name"/>
    </div>
    <div class="search-field source-type">
        <label for="developer-source-type">Source type</label>
        <select id="developer-source-type" class="form-select" @bind="_search.SourceType">
            @foreach (var sourceType in Enum.GetValues<SongSourceType>())
            {
                <option value="@sourceType">@sourceType</option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary" disabled="@_isLoading">Search</button>
</form>
<p id="developer-search-help">Enter a VNDB ID or an exact developer name. If both are entered, the ID is used.</p>

@if (_error != null)
{
    <p role="alert">@_error</p>
}
else if (_isLoading)
{
    <p role="status">Loading stats...</p>
}
else if (_stats != null)
{
    <h4>@_searchedDeveloper</h4>
    <p>Songs: @_stats.SongCount</p>
    @if (_stats.PlayerSongStats.Length == 0)
    {
        <p>No recorded plays for this developer.</p>
    }
    else
    {
        <div class="page-size-chooser">
            Items per page:
            <select @bind="@_pagination.ItemsPerPage">
                <option>10</option>
                <option>25</option>
                <option>50</option>
                <option>100</option>
                <option>250</option>
            </select>
        </div>
        <Paginator State="@_pagination"/>
        <div class="grid" tabindex="-1">
            <QuickGrid Items="@_stats.PlayerSongStats.AsQueryable()" Pagination="@_pagination">
                <PropertyColumn Property="@(x => x.Username)" Title="Username" Sortable="true"/>
                <PropertyColumn Property="@(x => x.TimesPlayed)" Title="Play count" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending"/>
                <PropertyColumn Property="@(x => x.TimesCorrect)" Title="Correct" Sortable="true"/>
                <TemplateColumn Title="Guess rate" Sortable="true" SortBy="@(GridSort<PlayerSongStats>.ByAscending(x => x.CorrectPercentage))">
                    @(Math.Round(context.CorrectPercentage, 2))%
                </TemplateColumn>
                <PropertyColumn Property="@(x => x.VoteAverage)" Title="Vote avg." Sortable="true"/>
                <PropertyColumn Property="@(x => x.VoteCount)" Title="Vote count" Sortable="true"/>
            </QuickGrid>
        </div>
    }
}

@code {
    private readonly ReqGetDeveloperStats _search = new();
    private AutocompleteDeveloperComponent? _developerAutocomplete;
    private ResGetDeveloperStats? _stats;
    private string? _searchedDeveloper;
    private string? _error;
    private bool _isLoading;
    private readonly PaginationState _pagination = new() { ItemsPerPage = 10 };

    private async Task Search()
    {
        if (_isLoading)
        {
            return;
        }

        var req = new ReqGetDeveloperStats
        {
            DeveloperId = _search.DeveloperId.Trim(),
            Name = (_developerAutocomplete?.GetSelectedText() ?? _search.Name ?? "").Trim(),
            SourceType = _search.SourceType,
        };
        _stats = null;
        _error = null;
        if (string.IsNullOrWhiteSpace(req.DeveloperId) && string.IsNullOrWhiteSpace(req.Name))
        {
            _error = "Enter a VNDB ID or developer name.";
            return;
        }

        _isLoading = true;
        _searchedDeveloper = $"{(req.DeveloperId.Length > 0 ? req.DeveloperId : req.Name)} ({req.SourceType})";
        try
        {
            await _clientUtils.TryRestoreSession();
            using var response = await _client.PostAsJsonAsync("Library/GetDeveloperStats", req);
            var stats = response.IsSuccessStatusCode
                ? await response.Content.ReadFromJsonAsync<ResGetDeveloperStats>()
                : null;
            _stats = stats;
            _error = stats == null ? "Could not load developer stats. Please try again." : null;
            await _pagination.SetCurrentPageIndexAsync(0);
        }
        catch (HttpRequestException)
        {
            _error = "Could not load developer stats. Please try again.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
